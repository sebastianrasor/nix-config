{{~header 'Link' '<' (lookup assets '/stylesheet.css') '>; rel=preload; as=style; fetchpriority=high'~}}
{{~header 'Link' '<' (lookup assets '/AtkinsonHyperlegibleNextVF-Variable.woff2') '>; rel=preload; as="font"; type="font/woff2"; fetchpriority=high; crossorigin'~}}
{{~header 'Link' '<' (lookup assets '/contact.js') '>; rel=modulepreload'~}}
{{~header 'Link' '<https://challenges.cloudflare.com>; rel=preconnect'~}}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="color-scheme" content="dark light">
    <meta name="description"
          content="You can contact Sebastian Rasor through this page.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="https://www.sebastianrasor.com/contact">
    <link rel="prefetch" href="/">
    <link rel="prefetch" href="/targets">
    <link rel="stylesheet" href="{{lookup assets '/stylesheet.css'}}">
    <title>Contact Sebastian Rasor</title>
    <script type="module" src="{{lookup assets '/contact.js'}}"></script>
    <script defer
            src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
  </head>
  <body>
    <main>
      <article id="success" tabindex="-1" hidden>
        <hgroup>
          <h1>Thanks for reaching out!</h1>
          <p>
            I've received your message and I'll get back to you as soon as
            possible.
          </p>
        </hgroup>
        <p>
          <a href="/">Return to www.sebastianrasor.com</a>
        </p>
      </article>
      <form id="contact-form">
        <h1 class="visually-hidden">Contact Sebastian Rasor</h1>
        <noscript>This form requires JavaScript to function.</noscript>
        <div class="horizontal-container">
          <div class="input-container">
            <span class="input-underline" aria-hidden="true"></span>
            <input type="text"
                   id="name"
                   name="name"
                   autocomplete="name"
                   placeholder=" "
                   required>
            <label for="name">Your Name</label>
          </div>
          <div class="input-container">
            <span class="input-underline" aria-hidden="true"></span>
            <input type="email"
                   id="email"
                   name="email"
                   autocomplete="email"
                   placeholder=" "
                   required>
            <label for="email">Your Email</label>
          </div>
        </div>
        <div class="input-container">
          <textarea id="message"
                    name="message"
                    autocomplete="off"
                    placeholder=" "
                    rows="4"
                    required></textarea>
          <label for="message">
            <span class="label-text">Your Message</span>
            <span id="form-status" class="label-status" role="status"></span>
          </label>
        </div>
        <button class="button" type="submit" id="submit-button" disabled>Please wait...</button>
        <div class="cf-turnstile"
             data-sitekey="{{turnstile_sitekey}}"
             data-appearance="interaction-only"
             data-response-field="false"
             hidden></div>
      </form>
    </main>
    <nav aria-label="Primary">
      <a class="button" href="/">Home</a>
      <a class="button" href="/contact" aria-current="page">Contact</a>
      <a class="button" href="/targets">Targets</a>
    </nav>
  </body>
</html>
